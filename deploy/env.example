# 义乌AI圈 · 生产环境配置模板
# 复制到 /etc/yiwu-ai-circle/env，只让 root 可读：chmod 600 /etc/yiwu-ai-circle/env
# 这个文件里有密钥，不要提交到 Git。

NODE_ENV=production
HOST=127.0.0.1
PORT=8000
PUBLIC_URL=https://yiwuai.homes
DATA_DIR=/var/lib/yiwu-ai-circle
COOKIE_SECURE=1
# 前面是同机的 Caddy，只信任本机转发过来的头
TRUST_PROXY=1
TRUSTED_PROXY_IPS=127.0.0.1,::1

# 用 openssl rand -hex 32 生成
SESSION_SECRET=
# 后台账号；密码至少 12 位，用 openssl rand -base64 18 生成
ADMIN_USER=
ADMIN_PASS=

# 会员登录：短信没开通前用 off（登录页显示「暂未开放」，活动报名照常）
# 开通后改成 api 并填两个接口地址，同时把 assets/js/config.js 里的 sms.mode 改为 "api"
SMS_MODE=off
SMS_SEND_URL=
SMS_VERIFY_URL=

# 报名后发邀请函邮件（不填就不发）
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 商家认证付费（不用可以留空）
WAG_API_KEY=
WAG_ENTITLEMENT_ID=
CERT_PRICE=99
